```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
.venv/
venv/
env/

# Dependencies
node_modules/

# Data
output_csv/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Environment files
.env
.env.local
*.env.*

# Coverage reports
.coverage
coverage/
htmlcov/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
build/
dist/
target/
*.o
*.obj
*.so
*.dylib
*.dll
*.exe

# Cache directories
.mypy_cache/
.pytest_cache/
.gradle/
```
